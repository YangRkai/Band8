{
  "name": "band8",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "band8": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:runtime": "vitest run tests/runtime",
    "test:parity": "vitest run tests/runtime/protocol-parity.test.ts tests/runtime/cross-language-canonical.test.ts",
    "test:golden": "vitest run tests/runtime/runtime-golden.test.ts -t \"Reading Golden Run\"",
    "test:writing": "vitest run tests/runtime/writing-protocol.test.ts tests/runtime/artifact-store.test.ts tests/runtime/writing-runtime.test.ts tests/runtime/continuation-runtime.test.ts tests/runtime/writing-golden.test.ts",
    "generate:writing-fixtures": "node tests/runtime/fixtures/writing-golden/generate.mjs",
    "smoke:writing": "node tests/runtime/manual-writing-smoke.mjs",
    "test:crash": "vitest run tests/runtime/runtime-golden.test.ts -t \"survives restart\"",
    "test:idempotency": "vitest run tests/runtime/storage-runtime.test.ts tests/runtime/runtime-golden.test.ts -t \"persists import identity|different canonical content|duplicate resume|rebuilds\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}

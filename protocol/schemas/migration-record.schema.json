{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://band8.local/protocol/0.1/migration-record.schema.json",
  "title": "Band8 Migration Record 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "migration_id", "created_at", "source_record_id", "source_content_hash", "from_contract_set", "to_contract_set", "migrated_record_id", "migration_version", "original_preserved"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "protocol_version": {"const": "0.1.0"},
    "migration_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_record_id": {"$ref": "#/$defs/id"},
    "source_content_hash": {"$ref": "#/$defs/hash"},
    "from_contract_set": {"type": "string", "minLength": 1, "maxLength": 200},
    "to_contract_set": {"type": "string", "minLength": 1, "maxLength": 200},
    "migrated_record_id": {"$ref": "#/$defs/id"},
    "migration_version": {"type": "string", "minLength": 1, "maxLength": 40},
    "original_preserved": {"const": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

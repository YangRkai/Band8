{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://band8.local/protocol/0.1/session-event.schema.json",
  "title": "Band8 Session Event 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "event_id", "event_type", "session_id", "run_id", "segment_id", "package_id", "activity_id", "timestamp", "monotonic_offset_ms", "sequence_number", "payload"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "protocol_version": {"const": "0.1.0"},
    "event_id": {"$ref": "#/$defs/id"},
    "event_type": {"enum": ["session_started", "session_paused", "session_resumed", "session_suspended", "session_completed", "session_abandoned", "session_quarantined", "coach_checkpoint_reached", "clock_anomaly_detected", "activity_started", "activity_completed", "answer_selected", "answer_changed", "answer_submitted", "audio_started", "audio_paused", "audio_replayed", "text_revisited", "evidence_selected", "evidence_changed", "hint_requested", "correction_started", "correction_submitted", "retry_started", "retry_completed", "self_rating_submitted", "writing_revision_created", "speaking_recording_created", "artifact_created", "reinforcement_awarded", "assessment_submitted", "record_invalidated", "record_migrated"]},
    "session_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "segment_id": {"$ref": "#/$defs/id"},
    "package_id": {"$ref": "#/$defs/id"},
    "activity_id": {"type": ["string", "null"], "maxLength": 128},
    "timestamp": {"type": "string", "format": "date-time"},
    "monotonic_offset_ms": {"type": "integer", "minimum": 0},
    "sequence_number": {"type": "integer", "minimum": 1},
    "payload": {"$ref": "#/$defs/typed_payload"},
    "supersedes": {"type": ["string", "null"], "maxLength": 128},
    "invalidates": {"type": ["string", "null"], "maxLength": 128},
    "migration_version": {"type": ["string", "null"], "maxLength": 40}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "typed_payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 12,
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "segment_id": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["training", "assessment"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 300},
        "resume_operation_id": {"$ref": "#/$defs/id"},
        "checkpoint_id": {"$ref": "#/$defs/id"},
        "required_evidence_refs": {"$ref": "#/$defs/ids"},
        "completed_activity_ids": {"$ref": "#/$defs/ids"},
        "invalid_record_refs": {"$ref": "#/$defs/ids"},
        "previous_timestamp": {"type": "string", "format": "date-time"},
        "current_timestamp": {"type": "string", "format": "date-time"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "option_ids": {"$ref": "#/$defs/ids"},
        "response_kind": {"enum": ["selection", "mapping", "order", "text", "evidence_spans", "audio", "self_rating"]},
        "text_value": {"type": "string", "maxLength": 12000},
        "ordered_item_ids": {"$ref": "#/$defs/ids"},
        "pairs": {"type": "array", "maxItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["left_id", "right_id"], "properties": {"left_id": {"$ref": "#/$defs/id"}, "right_id": {"$ref": "#/$defs/id"}}}},
        "output_ref": {"$ref": "#/$defs/id"},
        "resource_id": {"$ref": "#/$defs/id"},
        "visit_count": {"type": "integer", "minimum": 1},
        "play_number": {"type": "integer", "minimum": 1},
        "position_ms": {"type": "integer", "minimum": 0},
        "spans": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}}}},
        "hint_type": {"type": "string", "minLength": 1, "maxLength": 80},
        "revision_of": {"$ref": "#/$defs/id"},
        "feedback_ref": {"$ref": "#/$defs/id"},
        "source_output_ref": {"$ref": "#/$defs/id"},
        "rating": {"type": "integer", "minimum": 0, "maximum": 10},
        "artifact_id": {"$ref": "#/$defs/id"},
        "decision_id": {"$ref": "#/$defs/id"},
        "activity_ids": {"$ref": "#/$defs/ids"},
        "target_record_id": {"$ref": "#/$defs/id"},
        "migration_record_id": {"$ref": "#/$defs/id"}
      }
    },
    "ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}

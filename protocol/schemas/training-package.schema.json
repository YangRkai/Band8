{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://band8.local/protocol/0.1/training-package.schema.json",
  "title": "Band8 Training Package 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "package_id", "created_at", "generator",
    "contract_versions", "learner_goal", "session_intent", "estimated_duration_minutes",
    "training_rationale", "target_skills", "training_hypotheses", "resources", "phases",
    "activities", "feedback_policy", "completion_policy", "reinforcement_hints",
    "evidence_requirements"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "protocol_version": {"const": "0.1.0"},
    "package_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["producer", "producer_version"],
      "properties": {
        "producer": {"type": "string", "minLength": 1, "maxLength": 80},
        "producer_version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "contract_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["pedagogy_version", "coach_contract_version", "skill_taxonomy_version"],
      "properties": {
        "pedagogy_version": {"const": "0.1.0"},
        "coach_contract_version": {"const": "0.1.0"},
        "skill_taxonomy_version": {"const": "0.1.0"}
      }
    },
    "learner_goal": {"$ref": "#/$defs/learner_goal"},
    "session_intent": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "objective", "evidence_class"],
      "properties": {
        "mode": {"enum": ["training", "assessment"]},
        "objective": {"type": "string", "minLength": 1, "maxLength": 500},
        "evidence_class": {"enum": ["training_performance", "transfer_performance", "assessment_performance"]}
      }
    },
    "estimated_duration_minutes": {"type": "integer", "minimum": 1, "maximum": 120},
    "training_rationale": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "evidence_refs"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_refs": {"$ref": "#/$defs/id_array"}
      }
    },
    "target_skills": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/skill_id"}},
    "training_hypotheses": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["hypothesis_id", "purpose"],
        "properties": {
          "hypothesis_id": {"$ref": "#/$defs/id"},
          "purpose": {"enum": ["test", "support", "weaken", "falsify"]}
        }
      }
    },
    "available_evidence_refs": {"$ref": "#/$defs/id_array"},
    "resources": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["resource_id", "resource_type", "content_format", "content"],
        "properties": {
          "resource_id": {"$ref": "#/$defs/id"},
          "resource_type": {"enum": ["text", "audio_script", "rubric", "comparison"]},
          "content_format": {"enum": ["plain_text", "markdown_subset"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 12000}
        }
      }
    },
    "phases": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase_id", "kind", "activity_ids"],
        "properties": {
          "phase_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["cue", "generation", "instruction", "practice", "correction", "retry", "retrieval", "transfer", "assessment", "reflection"]},
          "activity_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "activities": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"$ref": "#/$defs/activity"}
    },
    "feedback_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "allow_hints", "allow_retry", "correction_timing"],
      "properties": {
        "mode": {"enum": ["training", "assessment"]},
        "allow_hints": {"type": "boolean"},
        "allow_retry": {"type": "boolean"},
        "correction_timing": {"enum": ["after_submission", "after_activity", "after_session", "none"]}
      }
    },
    "completion_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["required_activity_ids", "allow_partial_result"],
      "properties": {
        "required_activity_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "allow_partial_result": {"type": "boolean"}
      }
    },
    "reinforcement_hints": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_types"],
      "properties": {
        "candidate_types": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["breakthrough_candidate", "boss_fight_candidate", "milestone_candidate"]}}
      }
    },
    "evidence_requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["required_event_types", "artifact_types"],
      "properties": {
        "required_event_types": {"type": "array", "minItems": 2, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "artifact_types": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["essay", "rewrite", "speaking_audio", "transcript", "highlighted_evidence", "long_form_answer"]}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
    "id_array": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "learner_goal": {
      "type": "object", "additionalProperties": false,
      "required": ["overall_target", "section_minimums"],
      "properties": {
        "overall_target": {"type": "number", "minimum": 0, "maximum": 9},
        "section_minimums": {
          "type": "object", "additionalProperties": false,
          "required": ["listening", "reading", "writing", "speaking"],
          "properties": {
            "listening": {"type": "number", "minimum": 0, "maximum": 9},
            "reading": {"type": "number", "minimum": 0, "maximum": 9},
            "writing": {"type": "number", "minimum": 0, "maximum": 9},
            "speaking": {"type": "number", "minimum": 0, "maximum": 9}
          }
        }
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_id", "type", "phase_id", "skill_refs", "prompt", "resource_refs", "config", "completion", "feedback", "timeout", "accessibility", "evidence_requirements"],
      "properties": {
        "activity_id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["INSTRUCTION", "PRESENT_TEXT", "PLAY_AUDIO", "SELECT", "MATCH", "ORDER", "TEXT_RESPONSE", "EVIDENCE_SELECT", "SPEAK_RECORD", "COMPARE_REVISE", "RETRIEVAL_PROMPT", "SELF_ASSESS"]},
        "phase_id": {"$ref": "#/$defs/id"},
        "skill_refs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/skill_id"}},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 2000},
        "resource_refs": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "config": {"type": "object", "maxProperties": 20},
        "completion": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "submit_required"],
          "properties": {"required": {"type": "boolean"}, "submit_required": {"type": "boolean"}}
        },
        "feedback": {
          "type": "object", "additionalProperties": false,
          "required": ["timing", "allowed"],
          "properties": {
            "timing": {"enum": ["none", "after_submission", "after_activity", "after_session"]},
            "allowed": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["correctness", "explanation", "rubric", "comparison", "retry_invitation"]}}
          }
        },
        "timeout": {
          "type": "object", "additionalProperties": false,
          "required": ["limit_seconds", "on_timeout"],
          "properties": {"limit_seconds": {"type": "integer", "minimum": 10, "maximum": 7200}, "on_timeout": {"enum": ["record_incomplete", "submit_current", "abandon_activity"]}}
        },
        "accessibility": {
          "type": "object", "additionalProperties": false,
          "required": ["keyboard_operable", "screen_reader_label"],
          "properties": {"keyboard_operable": {"type": "boolean"}, "screen_reader_label": {"type": "string", "minLength": 1, "maxLength": 300}, "transcript_resource_ref": {"$ref": "#/$defs/id"}}
        },
        "evidence_requirements": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
      }
    }
  }
}
